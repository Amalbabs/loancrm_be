generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int        @id @default(autoincrement())
  name            String     @db.VarChar(100)
  email           String     @unique @db.VarChar(150)
  password        String     @db.VarChar(255)
  role            String     @default("STAFF") @db.VarChar(20)
  phone           String?    @db.VarChar(20)
  dailyCallTarget Int        @default(100) @map("daily_call_target")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")

  leads           Lead[]
  callLogs        CallLog[]
  documents       Document[] @relation("UserUploadedDocs")
  verifiedDocs    Document[] @relation("AdminVerifiedDocs")

  @@map("users")
}

model Lead {
  id            Int        @id @default(autoincrement())
  fullName      String     @map("full_name") @db.VarChar(150)
  phone         String     @db.VarChar(25)
  email         String?    @db.VarChar(150)
  loanType      String     @default("Personal Loan") @map("loan_type") @db.VarChar(60)
  loanAmount    Decimal    @default(0.00) @map("loan_amount") @db.Decimal(14, 2)
  monthlyIncome Decimal    @default(0.00) @map("monthly_income") @db.Decimal(14, 2)
  creditScore   Int?       @map("credit_score")
  status        String     @default("NEW") @db.VarChar(50)
  assignedTo    Int?       @map("assigned_to")
  followUpDate  DateTime?  @map("follow_up_date")
  notes         String?    @db.Text
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  assignedStaff User?      @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  callLogs      CallLog[]
  documents     Document[]

  @@map("leads")
}

model CallLog {
  id                  Int       @id @default(autoincrement())
  leadId              Int       @map("lead_id")
  staffId             Int       @map("staff_id")
  callStatus          String    @default("COMPLETED") @map("call_status") @db.VarChar(50)
  callDisposition     String    @map("call_disposition") @db.VarChar(50) // INTERESTED, CALLBACK_SCHEDULED, NOT_INTERESTED
  callDurationSeconds Int       @default(0) @map("call_duration_seconds")
  remarks             String?   @db.Text
  callbackDate        DateTime? @map("callback_date")
  rejectionReason     String?   @map("rejection_reason") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")

  lead                Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staff               User      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("call_logs")
}

model Document {
  id                  Int       @id @default(autoincrement())
  leadId              Int       @map("lead_id")
  uploadedBy          Int?      @map("uploaded_by")
  docType             String    @default("OTHER") @map("doc_type") @db.VarChar(50) // PAN, AADHAAR, BANK_STATEMENT, SALARY_SLIP, ITR
  fileName            String    @map("file_name") @db.VarChar(255)
  originalName        String    @map("original_name") @db.VarChar(255)
  filePath            String?   @map("file_path") @db.VarChar(255)
  fileType            String?   @map("file_type") @db.VarChar(100)
  fileSize            Int?      @map("file_size")
  fileData            Bytes?    @map("file_data")
  verificationStatus  String    @default("PENDING") @map("verification_status") @db.VarChar(30) // PENDING, APPROVED, REJECTED
  verificationRemarks String?   @map("verification_remarks") @db.Text
  verifiedBy          Int?      @map("verified_by")
  createdAt           DateTime  @default(now()) @map("created_at")

  lead                Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploader            User?     @relation("UserUploadedDocs", fields: [uploadedBy], references: [id], onDelete: SetNull)
  verifier            User?     @relation("AdminVerifiedDocs", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@map("documents")
}

model BankScheme {
  id              Int      @id @default(autoincrement())
  bankName        String   @map("bank_name") @db.VarChar(100) // HDFC, ICICI, SBI, etc.
  schemeName      String   @map("scheme_name") @db.VarChar(150)
  loanType        String   @map("loan_type") @db.VarChar(60)
  roi             Decimal  @db.Decimal(5, 2) // Rate of Interest in %
  processingFee   Decimal? @default(0.00) @map("processing_fee") @db.Decimal(5, 2)
  minCreditScore  Int?     @default(650) @map("min_credit_score")
  minTenureMonths Int?     @default(12) @map("min_tenure_months")
  maxTenureMonths Int?     @default(84) @map("max_tenure_months")
  maxAmount       Decimal? @default(0.00) @map("max_amount") @db.Decimal(14, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("bank_schemes")
}
